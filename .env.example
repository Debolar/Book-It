# Copy to .env and fill in real values. Never commit .env.
APP_ENV=local
APP_VERSION=dev
# Secret that unlocks the admin page. Use a long random value; never commit the real one.
ADMIN_API_KEY=change-me-to-a-long-random-value
# Leave empty to use the in-memory store.
# In Docker Compose, the host is the database service name (e.g. "db").
DATABASE_URL=postgresql://bookit:change-me@localhost:5432/bookit

# Used by the postgres container
POSTGRES_USER=bookit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookit
